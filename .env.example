# Local development only. Copy to .env; never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://incidentdesk:local-course-only@127.0.0.1:55432/incidentdesk

# Set the following explicitly in Vercel, not by uploading this local .env:
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=<private random stable value, at least 50 characters>
# DATABASE_URL=<your isolated PostgreSQL database URL with TLS>
# DJANGO_ALLOWED_HOSTS=<your exact deployment hostname, without scheme>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<your exact deployment hostname>

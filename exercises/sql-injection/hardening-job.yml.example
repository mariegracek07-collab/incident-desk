# Add this job to your course's workflow after the challenge is assigned.
# It deliberately fails until the student fixes the query; no deployment credentials needed.
search-hardening:
  runs-on: ubuntu-latest
  timeout-minutes: 10
  steps:
    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
    - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
      with:
        python-version: '3.12'
    - run: python -m pip install -r requirements.txt
    - run: python manage.py test training.tests.test_hardening --settings=config.settings.security_lab
